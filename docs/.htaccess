# Hostinger / LiteSpeed. GitHub Pages ignores this server configuration.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Do not serve repository metadata; allow standard ACME validation.
  RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
  # Clean addresses: /ru/index.html -> /ru/. Only the visitor's own request is matched,
  # so the internal DirectoryIndex lookup cannot loop. The query string is kept.
  RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.html[?\s] [NC]
  RewriteRule ^ https://hram.lt/%1 [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^www\.hram\.lt$ [NC,OR]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://hram.lt%{REQUEST_URI} [R=301,L,NE]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  # Browsers keep using HTTPS for a year; subdomains are deliberately not included.
  Header always set Strict-Transport-Security "max-age=31536000"
  # Stable filenames must revalidate after each GitHub release.
  <FilesMatch "\.(html|css|js|json|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
